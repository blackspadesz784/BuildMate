# --------------------------------------------------------------------------
# BuildMate — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit your actual .env file to version control.
# --------------------------------------------------------------------------

# Your Google Gemini API key (get one from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_actual_gemini_api_key_here

# Gemini model to use (gemini-2.0-flash recommended)
GEMINI_MODEL=gemini-2.0-flash

# Flask server port
PORT=5000

# Set to False in production
FLASK_DEBUG=False

# A random secret key for Flask sessions (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=your_random_secret_key_here
